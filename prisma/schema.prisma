datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum PriceType {
  lista
  credito
  transferencia
  contado
}

enum PaymentMethod {
  efectivo
  transferencia
  cheque
}

// ─── Multi-tenant ─────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  users            User[]
  customers        Customer[]
  suppliers        Supplier[]
  products         Product[]
  transactions     Transaction[]
  payments         Payment[]
  purchases        Purchase[]
  purchasePayments PurchasePayment[]
  @@map("organizations")
}

model User {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")

  tenant Organization @relation(fields: [tenantId], references: [id])

  @@map("users")
}

// ─── Clientes ─────────────────────────────────────────────────────────────────

model Customer {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String
  phoneWhatsapp String?  @map("phone_whatsapp")
  address       String?
  notes         String?
  balanceDue    Decimal  @default(0) @map("balance_due") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  tenant       Organization  @relation(fields: [tenantId], references: [id])
  transactions Transaction[]

  @@map("customers")
}

// ─── Proveedores ──────────────────────────────────────────────────────────────

model Supplier {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String
  phoneWhatsapp String?  @map("phone_whatsapp")
  notes         String?
  balanceDue    Decimal  @default(0) @map("balance_due") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  tenant    Organization @relation(fields: [tenantId], references: [id])
  purchases Purchase[]

  @@map("suppliers")
}

// ─── Productos ────────────────────────────────────────────────────────────────

model Product {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  sku           String?
  name          String
  unit          String?
  costPrice     Decimal? @map("cost_price") @db.Decimal(12, 2)
  priceList     Decimal? @map("price_list") @db.Decimal(12, 2)
  priceCredit   Decimal? @map("price_credit") @db.Decimal(12, 2)
  priceTransfer Decimal? @map("price_transfer") @db.Decimal(12, 2)
  priceCash     Decimal? @map("price_cash") @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  tenant       Organization  @relation(fields: [tenantId], references: [id])
  transactions Transaction[]
  purchases    Purchase[]

  @@unique([tenantId, sku])
  @@map("products")
}

// ─── Ventas ───────────────────────────────────────────────────────────────────

model Transaction {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  customerId  String    @map("customer_id")
  productId   String    @map("product_id")
  quantity    Decimal   @db.Decimal(10, 3)
  priceType   PriceType @map("price_type")
  unitPrice   Decimal   @map("unit_price") @db.Decimal(12, 2)
  totalAmount Decimal   @map("total_amount") @db.Decimal(12, 2)
  amountPaid  Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balanceDue  Decimal   @map("balance_due") @db.Decimal(12, 2)
  date        DateTime  @db.Date
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant   Organization @relation(fields: [tenantId], references: [id])
  customer Customer     @relation(fields: [customerId], references: [id])
  product  Product      @relation(fields: [productId], references: [id])
  payments Payment[]

  @@map("transactions")
}

model Payment {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  transactionId String        @map("transaction_id")
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  paidAt        DateTime      @default(now()) @map("paid_at")
  notes         String?

  tenant      Organization @relation(fields: [tenantId], references: [id])
  transaction Transaction  @relation(fields: [transactionId], references: [id])

  @@map("payments")
}

// ─── Compras ──────────────────────────────────────────────────────────────────

model Purchase {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  supplierId    String    @map("supplier_id")
  productId     String    @map("product_id")
  quantity      Decimal   @db.Decimal(10, 3)
  priceType     PriceType @map("price_type")
  unitPrice     Decimal   @map("unit_price") @db.Decimal(12, 2)
  totalAmount   Decimal   @map("total_amount") @db.Decimal(12, 2)
  amountPaid    Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balanceDue    Decimal   @map("balance_due") @db.Decimal(12, 2)
  commissionPct Decimal   @default(0) @map("commission_pct") @db.Decimal(5, 2)
  date          DateTime  @db.Date
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant           Organization    @relation(fields: [tenantId], references: [id])
  supplier         Supplier        @relation(fields: [supplierId], references: [id])
  product          Product         @relation(fields: [productId], references: [id])
  purchasePayments PurchasePayment[]

  @@map("purchases")
}

model PurchasePayment {
  id         String        @id @default(uuid())
  tenantId   String        @map("tenant_id")
  purchaseId String        @map("purchase_id")
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod
  paidAt     DateTime      @default(now()) @map("paid_at")
  notes      String?

  tenant   Organization @relation(fields: [tenantId], references: [id])
  purchase Purchase     @relation(fields: [purchaseId], references: [id])

  @@map("purchase_payments")
}

