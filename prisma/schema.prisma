datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum PriceType {
  lista
  credito
  transferencia
  contado
}

enum PaymentMethod {
  efectivo
  transferencia
  cheque
}

enum EntryStatus {
  active
  cancelled
}

enum PlanStatus {
  active
  completed
  cancelled
}

enum InstallmentFrequency {
  semanal
  quincenal
  mensual
}

enum InstallmentStatus {
  pending
  paid
  cancelled
}

// ─── Multi-tenant ─────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  users                    User[]
  customers                Customer[]
  suppliers                Supplier[]
  products                 Product[]
  transactions             Transaction[]
  purchases                Purchase[]
  accountPayments          AccountPayment[]
  supplierPayments         SupplierPayment[]
  paymentPlans             PaymentPlan[]
  paymentPlanInstallments  PaymentPlanInstallment[]

  @@map("organizations")
}

model User {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")

  tenant Organization @relation(fields: [tenantId], references: [id])

  @@map("users")
}

// ─── Clientes ─────────────────────────────────────────────────────────────────

model Customer {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String
  phoneWhatsapp String?  @map("phone_whatsapp")
  address       String?
  notes         String?
  balanceDue    Decimal  @default(0) @map("balance_due") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  tenant                   Organization             @relation(fields: [tenantId], references: [id])
  transactions             Transaction[]
  accountPayments          AccountPayment[]
  paymentPlans             PaymentPlan[]
  paymentPlanInstallments  PaymentPlanInstallment[]

  @@map("customers")
}

// ─── Proveedores ──────────────────────────────────────────────────────────────

model Supplier {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String
  phoneWhatsapp String?  @map("phone_whatsapp")
  notes         String?
  balanceDue    Decimal  @default(0) @map("balance_due") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  tenant          Organization      @relation(fields: [tenantId], references: [id])
  purchases       Purchase[]
  supplierPayments SupplierPayment[]

  @@map("suppliers")
}

// ─── Productos ────────────────────────────────────────────────────────────────

model Product {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  sku           String?
  name          String
  unit          String?
  costPrice     Decimal? @map("cost_price") @db.Decimal(12, 2)
  priceList     Decimal? @map("price_list") @db.Decimal(12, 2)
  priceCredit   Decimal? @map("price_credit") @db.Decimal(12, 2)
  priceTransfer Decimal? @map("price_transfer") @db.Decimal(12, 2)
  priceCash     Decimal? @map("price_cash") @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  tenant       Organization  @relation(fields: [tenantId], references: [id])
  transactions Transaction[]
  purchases    Purchase[]

  @@unique([tenantId, sku])
  @@map("products")
}

// ─── Ventas ───────────────────────────────────────────────────────────────────

model Transaction {
  id          String      @id @default(uuid())
  tenantId    String      @map("tenant_id")
  customerId  String      @map("customer_id")
  productId   String?     @map("product_id")
  productName String?     @map("product_name")
  quantity    Decimal     @db.Decimal(10, 3)
  priceType   PriceType   @map("price_type")
  unitPrice   Decimal     @map("unit_price") @db.Decimal(12, 2)
  totalAmount Decimal     @map("total_amount") @db.Decimal(12, 2)
  date        DateTime    @db.Date
  notes       String?
  status      EntryStatus @default(active)
  createdAt   DateTime    @default(now()) @map("created_at")

  tenant       Organization  @relation(fields: [tenantId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  product      Product?      @relation(fields: [productId], references: [id])
  paymentPlans PaymentPlan[]

  @@map("transactions")
}

// ─── Cobros libres sobre cuenta de cliente ────────────────────────────────────

model AccountPayment {
  id         String        @id @default(uuid())
  tenantId   String        @map("tenant_id")
  customerId String        @map("customer_id")
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod
  date       DateTime      @db.Date
  notes      String?
  status     EntryStatus   @default(active)
  createdAt  DateTime      @default(now()) @map("created_at")

  tenant   Organization @relation(fields: [tenantId], references: [id])
  customer Customer     @relation(fields: [customerId], references: [id])

  @@map("account_payments")
}

// ─── Compras ──────────────────────────────────────────────────────────────────

model Purchase {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  supplierId    String      @map("supplier_id")
  productId     String      @map("product_id")
  quantity      Decimal     @db.Decimal(10, 3)
  priceType     PriceType   @map("price_type")
  unitPrice     Decimal     @map("unit_price") @db.Decimal(12, 2)
  totalAmount   Decimal     @map("total_amount") @db.Decimal(12, 2)
  commissionPct Decimal     @default(0) @map("commission_pct") @db.Decimal(5, 2)
  date          DateTime    @db.Date
  notes         String?
  status        EntryStatus @default(active)
  createdAt     DateTime    @default(now()) @map("created_at")

  tenant   Organization @relation(fields: [tenantId], references: [id])
  supplier Supplier     @relation(fields: [supplierId], references: [id])
  product  Product      @relation(fields: [productId], references: [id])

  @@map("purchases")
}

// ─── Planes de cuotas ─────────────────────────────────────────────────────────

model PaymentPlan {
  id               String               @id @default(uuid())
  tenantId         String               @map("tenant_id")
  customerId       String               @map("customer_id")
  transactionId    String?              @map("transaction_id")
  description      String
  totalAmount      Decimal              @map("total_amount") @db.Decimal(12, 2)
  installmentCount Int                  @map("installment_count")
  frequency        InstallmentFrequency
  firstDueDate     DateTime             @map("first_due_date") @db.Date
  status           PlanStatus           @default(active)
  createdAt        DateTime             @default(now()) @map("created_at")

  tenant        Organization            @relation(fields: [tenantId], references: [id])
  customer      Customer                @relation(fields: [customerId], references: [id])
  transaction   Transaction?            @relation(fields: [transactionId], references: [id])
  installments  PaymentPlanInstallment[]

  @@map("payment_plans")
}

model PaymentPlanInstallment {
  id                String            @id @default(uuid())
  tenantId          String            @map("tenant_id")
  planId            String            @map("plan_id")
  customerId        String            @map("customer_id")
  installmentNumber Int               @map("installment_number")
  dueDate           DateTime          @map("due_date") @db.Date
  expectedAmount    Decimal           @map("expected_amount") @db.Decimal(12, 2)
  status            InstallmentStatus @default(pending)
  createdAt         DateTime          @default(now()) @map("created_at")

  tenant   Organization @relation(fields: [tenantId], references: [id])
  plan     PaymentPlan  @relation(fields: [planId], references: [id])
  customer Customer     @relation(fields: [customerId], references: [id])

  @@map("payment_plan_installments")
}

// ─── Pagos libres sobre cuenta de proveedor ───────────────────────────────────

model SupplierPayment {
  id         String        @id @default(uuid())
  tenantId   String        @map("tenant_id")
  supplierId String        @map("supplier_id")
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod
  date       DateTime      @db.Date
  notes      String?
  status     EntryStatus   @default(active)
  createdAt  DateTime      @default(now()) @map("created_at")

  tenant   Organization @relation(fields: [tenantId], references: [id])
  supplier Supplier     @relation(fields: [supplierId], references: [id])

  @@map("supplier_payments")
}
